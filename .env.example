# 数据库配置
DATABASE_URL=postgres://timeline:timeline@localhost:5432/timeline
PGUSER=timeline
PGPASSWORD=timeline
PGHOST=localhost
PGPORT=5432
PGDATABASE=timeline
DB_POOL_MAX=5

# Elasticsearch配置 (可选)
ELASTICSEARCH_URL=http://localhost:9200

# 轮询间隔
REFRESH_INTERVAL_MINUTES=15
BACKGROUND_SWEEP_ENABLED=true
BACKGROUND_SWEEP_RUN_ON_START=false
BACKGROUND_SWEEP_STARTUP_DELAY_MS=30000
BACKGROUND_SWEEP_PARALLEL_SOURCES=false
BACKGROUND_SWEEP_LIMIT=20

# 服务器配置
PORT=3118

# 数据平台处理版本（B01-B07）
DATA_SCHEMA_VERSION=1.0.0
PARSER_VERSION=legacy-v1
PROMPT_VERSION=legacy-v1
NORMALIZATION_VERSION=legacy-v1
RELATIONSHIP_LOGIC_VERSION=legacy-v1

# A01/A02 event bus
EVENT_BUS_ENABLED=false
PARSER_AUTHORITY_MODE=inline
PARSER_RESULT_CONSUMER_GROUP=event-timeline-parser-result-v1
PARSER_RESULT_FROM_BEGINNING=false
DWD_AUTHORITY_MODE=postgres
QUERY_AUTHORITY_MODE=legacy
DATA_PLATFORM_RUNTIME_VALIDATED=false
REDPANDA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=event-timeline
OUTBOX_POLL_INTERVAL_MS=1000
PARSER_CONSUMER_GROUP=event-timeline-parser-v1
TOPIC_NEWS_RAW=ods.news.raw.v1
TOPIC_PARSER_REQUEST=parser.request.v1
TOPIC_PARSER_RESULT=parser.result.v1
TOPIC_PROTO_EVENT=dwd.proto-event.v1
TOPIC_DEAD_LETTER=dlq.pipeline.v1

# A05-A09 realtime/query/agent
FLINK_CHECKPOINT_URI=s3://warehouse/checkpoints
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_VERSION=embedding-v1
QUERY_TIMEOUT_MS=5000
QUERY_MAX_ROWS=100

# Dashboard 展示数量限制
DASHBOARD_HOT_EVENTS_LIMIT=8
DASHBOARD_ACTIVE_STORIES_LIMIT=8
DASHBOARD_PENDING_HYPOTHESES_LIMIT=10
DASHBOARD_RECENT_NEWS_LIMIT=10
DASHBOARD_PARSE_WATCHLIST_LIMIT=10
DASHBOARD_STORIES_DEFAULT_LIMIT=50
DASHBOARD_STORIES_MAX_LIMIT=200
DASHBOARD_HYPOTHESES_DEFAULT_LIMIT=50
DASHBOARD_HYPOTHESES_MAX_LIMIT=200
DASHBOARD_PENDING_NORMALIZATIONS_DEFAULT_LIMIT=100
DASHBOARD_PENDING_NORMALIZATIONS_MAX_LIMIT=1000
DASHBOARD_NEWS_PARSE_DEFAULT_LIMIT=40
DASHBOARD_NEWS_PARSE_MAX_LIMIT=100
DASHBOARD_CANONICAL_EVENTS_LIMIT=50
DASHBOARD_CANONICAL_EVENTS_MAX_LIMIT=100
DASHBOARD_RELATIONSHIP_ITEMS_LIMIT=50
DASHBOARD_RELATIONSHIP_ITEMS_MAX_LIMIT=100

# GDELT配置
GDELT_API_KEY=

# RSS 新闻源配置
RSS_NEWS_ENABLED=false
RSS_NEWS_FEEDS=
RSS_NEWS_MAX_ITEMS_PER_FEED=10

# 可选的爬虫配置
PUPPETEER_HEADLESS=true

# Provisional entity/action audit
NORMALIZATION_AUDIT_ENABLED=true
NORMALIZATION_AUDIT_RUN_ON_START=false
NORMALIZATION_AUDIT_INTERVAL_MS=86400000
NORMALIZATION_AUDIT_APPLY=false
NORMALIZATION_AUDIT_LIMIT=20
NORMALIZATION_REBUILD_PARSER=llm
NORMALIZATION_REBUILD_WORKER_ENABLED=false
ATOMIC_SUMMARY_WORKER_ENABLED=false
ATOMIC_BATCH_ASSIGNMENT_WORKER_ENABLED=false
